# Node
node_modules/
dist/
*.log
.vite/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Scraper cache (raw HTML)
scraper/cache/
# scraper/output/*.json is committed: it's the corpus snapshot the CI build
# feeds into the pipeline. Re-running the scraper hits UBC servers, so we'd
# rather pin a known-good crawl than regenerate every deploy.

# Pipeline output (regenerated in CI from scraper/output/)
pipeline/output/
web/public/data/*.bin
web/public/data/chunks.json

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.local
.env.*.local

# Claude Code local workspace
.claude/
